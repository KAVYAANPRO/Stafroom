# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# Supabase — Project Settings → API in your Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Secret — full DB access, server-side only, never send to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Google Gemini — https://aistudio.google.com/apikey
# Without a key the server falls back to the offline generator (question-bank
# assembly), so the app still runs; AI-written questions need this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay — https://dashboard.razorpay.com/app/keys (test mode to start)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
